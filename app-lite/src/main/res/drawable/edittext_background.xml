<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State: when the EditText is focused -->
    <item android:state_focused="true">
        <shape >
            <solid android:color="?attr/colorSurface"/> <!-- Background color for focused state -->
            <corners android:radius="8dp"/> <!-- Rounded corners -->
            <stroke android:color="?attr/outlineColor" android:width="2dp"/> <!-- Border color for focused state -->
        </shape>
    </item>

    <!-- Default State: when the EditText is unfocused -->
    <item>
        <shape >
            <solid android:color="?attr/colorSurface"/> <!-- Background color for unfocused state -->
            <corners android:radius="8dp"/> <!-- Rounded corners -->
            <stroke android:color="?attr/outlineColor" android:width="2dp"/> <!-- Border color for default state -->
        </shape>
    </item>
</selector>
